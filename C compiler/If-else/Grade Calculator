#include <stdio.h>

int main()
{
    int grade;
    scanf("%d", &grade);

    if (grade >= 90)
        printf("Scored Mark is %d and it is A grade", grade);

    else if (grade <= 89 && grade >= 70)
        printf("Scored Mark is %d and it is B grade", grade);

    else if (grade >= 50 && grade <= 69)
        printf("Scored Mark is %d and it is C grade", grade);

    else
        printf("Scored Mark is %d Fail", grade);

    return 0;
}
